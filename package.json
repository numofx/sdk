{
  "name": "numo-engine-sdk",
  "packageManager": "bun@1.0.0",
  "author": "Numo",
  "repository": {
    "url": "git+https://github.com/numo/sdk.git",
    "type": "git"
  },
  "private": "true",

  "scripts": {
    "bootstrap": "lerna bootstrap",
    "clean": "lerna clean --yes",
    "document": "typedoc" ,
    "lint": "bun run eslint --ext .ts,.tsx .",
